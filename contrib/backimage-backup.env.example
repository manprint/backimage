# backimage-backup.sh — configuration file.
#
# Install as /etc/backimage/backup.env (mode 0600, root-owned) or pass it with
# -c FILE. The file is sourced by bash: quote values, and remember that a BI_*
# variable already present in the environment overrides the value set here.
#
#   install -d -m 0700 /etc/backimage
#   install -m 0600 backimage-backup.env.example /etc/backimage/backup.env

# ---------------------------------------------------------------------------
# identity of the job
# ---------------------------------------------------------------------------

# Short id: names the lock file, the log files and the notification title.
BI_JOB_NAME="prod-data"

# Free text sent with every notification. Say what this job protects and who
# owns it: it is the first thing read at 03:00 when something breaks.
BI_DESCRIPTION="Nightly backup of /srv/data (app uploads) — owner: platform team"

# ---------------------------------------------------------------------------
# what to back up, and where
# ---------------------------------------------------------------------------

# One path per line (a single line is split on whitespace instead). Paths with
# spaces must be on their own line.
BI_PATHS="/srv/data
/etc/myapp"

BI_REPO="ghcr.io/me/dumps"      # repository without a tag (required)
BI_TAG="daily"
BI_TIMESTAMP="true"             # append a UTC stamp: one tag per run
#BI_TIMESTAMP_FORMAT="20060102T150405Z"

# One glob per line. The pattern base is the archived path, see README.
BI_EXCLUDES="**/*.tmp
**/.cache/**"

# ---------------------------------------------------------------------------
# keys and credentials
# ---------------------------------------------------------------------------

# `backup` never reads BACKIMAGE_PASSPHRASE: it needs a file (mode 0600).
BI_PASSPHRASE_FILE="/etc/backimage/backup.pass"
#BI_RECIPIENTS="age1abc..."     # or one age public key per line
#BI_NO_ENCRYPT="false"          # true only for data that needs no secrecy
#BI_AGE_IDENTITY="/etc/backimage/keys.age"   # required to reuse a dedup key

# Registry credentials written by `backimage login`. root's cron does not read
# a normal user's XDG directory: point at the file explicitly.
BI_AUTH_FILE="/etc/backimage/auth.json"
#BI_REGISTRY_USER="me"          # when the registry holds several accounts

# ---------------------------------------------------------------------------
# pipeline
# ---------------------------------------------------------------------------

#BI_COMPRESSION="zstd"          # zstd|gzip|lz4|xz|none
#BI_COMPRESSION_LEVEL="3"
#BI_JOBS="3"                    # concurrent blob uploads
#BI_MAX_LAYER_SIZE="1GiB"
# The spool must hold the whole compressed backup, not one layer. $TMPDIR is a
# RAM tmpfs on many systems: point this at real disk.
BI_TEMP_DIR="/var/tmp/backimage"
#BI_ONE_FILE_SYSTEM="true"
#BI_ALLOW_DEGRADED="false"      # true: keep going past unreadable files
#BI_DEDUP="false"               # reveals chunk equality, read docs/dedup.md
BI_VERIFY_AFTER_PUSH="quick"    # quick|full|off
#BI_OUTPUT="registry"           # registry|daemon|oci-layout|tar
#BI_OUTPUT_PATH="/srv/oci"
#BI_LOCAL_REPO="false"
#BI_VERBOSE="0"                 # 1 = -v, 2 = -vv (goes to the log file)

# Anything not covered above, split on whitespace:
#BI_EXTRA_ARGS="--platform linux/amd64 --no-metadata"
# For flags whose value contains spaces, use the array form instead:
#BI_EXTRA_ARGV=(--exclude 'my dir/**')

# ---------------------------------------------------------------------------
# remote server (backimage listen-remote), for hosts with little temp space
# ---------------------------------------------------------------------------

#BI_REMOTE="backup.example:7575"
#BI_REMOTE_MODE="stream"        # stream (default) uses 4 KiB of local disk
#BI_TLS_PIN="ab12..."           # server certificate SHA-256, hex only
#BI_TLS_CA="/etc/backimage/ca.pem"
#BI_TLS_CERT="/etc/backimage/client.pem"
#BI_TLS_KEY="/etc/backimage/client.key"
#BI_AUTH_TOKEN_FILE="/etc/backimage/remote.token"
#BI_UDP="false"                 # QUIC instead of TCP

# ---------------------------------------------------------------------------
# execution
# ---------------------------------------------------------------------------

BI_TIMEOUT="6h"                 # empty or 0 = no limit; hitting it exits 124
BI_NICE="10"
BI_IONICE_CLASS="2"
BI_IONICE_LEVEL="7"
#BI_WORKDIR="/"                 # cwd of the run
#BI_LOCK_FILE="/var/lock/backimage-prod-data.lock"
BI_LOCK_WAIT="0"                # seconds to wait for a busy lock
BI_ON_LOCKED="fail"             # fail (exit 75 + notify) | skip (exit 0)

# Hooks: shell commands. The pre-command aborts the run when it fails; the
# post-command always runs and sees BI_STATUS, BI_EXIT_CODE, BI_REF,
# BI_LOG_FILE in its environment.
#BI_PRE_CMD="systemctl stop myapp"
#BI_POST_CMD="systemctl start myapp"

# ---------------------------------------------------------------------------
# logging
# ---------------------------------------------------------------------------

BI_LOG_DIR="/var/log/backimage" # one timestamped log per run
BI_LOG_KEEP="30"                # 0 = keep every log
BI_STDERR="auto"                # auto: only warnings and errors reach cron mail

# ---------------------------------------------------------------------------
# retention on the registry, after a successful backup
# ---------------------------------------------------------------------------

BI_PRUNE="false"                # true only once you trust the rules
BI_PRUNE_KEEP_LAST="14"
BI_PRUNE_KEEP_WITHIN="30d"
#BI_PRUNE_KEEP_TAGS="release-*"   # one glob per line to keep several
#BI_PRUNE_TAG_REGEX="daily-.*"  # never touch tags outside this pattern
#BI_PRUNE_EXTRA_ARGS="--group-by-regex ([a-z]+)_.*"
# A failed prune is a warning: it never turns a good backup into a failure.

# ---------------------------------------------------------------------------
# notification
# ---------------------------------------------------------------------------

BI_NOTIFY="on-error"            # always | on-error | never
BI_NOTIFY_TARGET="auto"         # auto | slack | google-chat

# Keep the webhook out of the environment and out of `ps`: a file, mode 0600.
BI_WEBHOOK_URL_FILE="/etc/backimage/webhook.url"
#BI_WEBHOOK_URL="https://hooks.slack.com/services/T000/B000/xxxx"

BI_NOTIFY_TIMEOUT="15"          # seconds per HTTP attempt
BI_NOTIFY_RETRIES="3"           # retried on 429, 5xx and transport errors
BI_NOTIFY_TAIL="20"             # log lines attached to a failure message
#BI_NOTIFY_MENTION="<!channel>" # Slack; Google Chat wants <users/all>
#BI_HOSTNAME="db01.prod"        # defaults to the machine name
